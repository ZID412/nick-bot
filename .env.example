# 必填：去 https://my.telegram.org 申请（不是 Bot Token！）
API_ID=
API_HASH=

# 你的 Telegram 注册手机号，带国家码，例如 +8613800138000
PHONE=

# 昵称前缀（普通英文/数字，脚本会自动转成粗斜体）
PREFIX=ZIDDDD.

# 刷新间隔
REFRESH_SECONDS=30
WEATHER_REFRESH_HOURS=2

# 坐标（默认珠海）和时区
LAT=22.27
LON=113.58
TIMEZONE=Asia/Shanghai

# 国内网络需要填本地代理，例如 socks5://127.0.0.1:1080 或 http://127.0.0.1:7890
# 不需要代理就留空
PROXY=
